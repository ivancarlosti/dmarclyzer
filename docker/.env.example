# DMARClyzer Environment Configuration
#
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#     nano .env
#
# .env is git-ignored. Never commit real credentials.

# IMAP Connection Setup
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USER=dmarc@example.com
IMAP_PASSWORD=your_imap_password
IMAP_FOLDER=INBOX
# Define folders to move messages to after processing. Leave blank to just mark as Read.
IMAP_MOVE_FOLDER=processed
IMAP_MOVE_FOLDER_ERR=error
# How often to check for new emails (in seconds, minimum 30)
FETCH_INTERVAL=300

# Maximum sizes accepted from inbound mail (in MiB)
MAX_ATTACHMENT_MB=25
MAX_XML_MB=10
MAX_ARCHIVE_UNCOMPRESSED_MB=50
MAX_ZIP_ENTRIES=10

# MariaDB Connection Details
# Use a strong, unique DB_PASSWORD — the application warns loudly when it falls
# back to the historical default.
DB_HOST=db
DB_PORT=3306
DB_NAME=dmarc
DB_USER=dmarcuser
DB_PASSWORD=dmarcpass
# Optional: path to a CA bundle inside the container to require TLS to MariaDB
DB_SSL_CA=

# Web Server & Reverse Proxy
# Port exposed to the Docker host machine
PORT=8080
# If you are using a reverse proxy (like Nginx), you can define the domain name here
DOMAIN=dmarclyzer.example.com

# Authentication method (none, account, keycloak)
AUTH_METHOD=none

# Account auth settings
ACCOUNT_LOGIN=
ACCOUNT_PASSWORD=
# Failed logins per browser session before lockout
LOGIN_MAX_ATTEMPTS=5
RECAPTCHA_CLIENTID=
# When this secret is set, a valid reCAPTCHA token is REQUIRED for account login
RECAPTCHA_CLIENTSECRET=

# Keycloak auth settings
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=dmarclyzer
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
# Also sent as post_logout_redirect_uri; Keycloak checks it against the
# client's post-logout redirect URIs (empty falls back to valid redirect URIs).
KEYCLOAK_REDIRECT_URI=https://dmarclyzer.example.com/
# REQUIRED for AUTH_METHOD=keycloak: comma-separated allow-list of email addresses
KEYCLOAK_EMAIL_ACCOUNT=youremail@example.com
# REQUIRED for AUTH_METHOD=keycloak: signs the OIDC state/PKCE material.
# Also signs the browser-session cookie, which is why it is recommended for
# AUTH_METHOD=account too (an unset value gets an ephemeral per-process key, so
# sessions then survive page refreshes but not container restarts).
# Generate a value with any of these (Python is NOT required):
#   openssl rand -hex 32
#   head -c 48 /dev/urandom | base64 | tr -d '\n'
#   od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
# Keep it stable: rotating it invalidates in-flight logins and every persisted
# browser session (users simply sign in again).
AUTH_STATE_SECRET=
AUTH_STATE_TTL_SECONDS=300
# How long a signed browser-session cookie keeps the dashboard open across page
# refreshes, in seconds. Set to 0 to require signing in again after every
# refresh. Values are clamped to 0..2592000 (30 days).
AUTH_SESSION_TTL_SECONDS=28800
# Only enable for local HTTP development; production issuers must use https://
ALLOW_INSECURE_IDP=false

# Report retention cleanup (in days). Reports older than this will be deleted.
# Set to 0 to disable automatic cleanup.
REPORT_RETENTION_DAYS=180
